{
  "build": [
    "mvn -q -DskipTests package 2>&1 | tail -30",
    "jar cfm target/v1-agent.jar agent/MANIFEST.MF -C target/test-classes fuzzing/agent -C target/test-classes fuzzing/v1/V1Counters.class"
  ],
  "classpath_command": "echo \"target/test-classes:target/classes:$(ls target/dependency/*.jar | tr '\\n' ':')\"",
  "javaagent": {"jar": "target/v1-agent.jar", "args": ""},
  "jvm_args": ["-Xmx1g", "-Xss1m"],
  "guidance_factory": "fuzzing.FuzzRunner#createGuidance",
  "targets": {"V1": {"test_class": "fuzzing.Bzip2DecoderFuzzTest", "method": "fuzzBzip2DecoderDecode"}}
}
