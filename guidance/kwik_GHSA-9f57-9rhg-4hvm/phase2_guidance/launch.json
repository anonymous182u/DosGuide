{
  "build": [
    "mvn package -DskipTests -q 2>&1 | tail -20",
    "bash scripts/build-agent.sh"
  ],
  "classpath": "target/test-classes:lib/kwik-0.10.jar:target/dependency/jqf-fuzz-2.1.jar:target/dependency/jqf-instrument-2.1.jar:target/dependency/junit-4.13.2.jar:target/dependency/junit-quickcheck-core-1.0.jar:target/dependency/junit-quickcheck-generators-1.0.jar:target/dependency/asm-9.8.jar:target/dependency/asm-commons-9.5.jar:target/dependency/asm-tree-9.5.jar:target/dependency/hamcrest-core-1.3.jar:target/dependency/javaruntype-1.3.jar:target/dependency/generics-resolver-3.0.1.jar:target/dependency/antlr-runtime-3.1.2.jar:target/dependency/ognl-3.1.12.jar:target/dependency/javassist-3.20.0-GA.jar:target/dependency/jackson-core-2.18.3.jar:target/dependency/jackson-databind-2.18.3.jar:target/dependency/jackson-annotations-2.18.3.jar:target/dependency/picocli-4.0.4.jar:target/dependency/slf4j-api-1.7.25.jar:target/dependency/kwik-0.10.jar:target/dependency/agent15-3.0.jar:target/dependency/hkdf-2.0.0.jar:target/dependency/eclipse-collections-10.4.0.jar:target/dependency/eclipse-collections-api-10.4.0.jar:target/dependency/org.jacoco.core-0.8.10.jar:target/dependency/org.jacoco.report-0.8.10.jar",
  "javaagent": {
    "jar": "target/agent/v1-measure-agent.jar",
    "args": ""
  },
  "jvm_args": [
    "-Xmx1g",
    "-Xss1m"
  ],
  "guidance_factory": "tech.kwik.fuzz.runner.FuzzRunner#createGuidance",
  "targets": {
    "V1": {
      "test_class": "tech.kwik.fuzz.harness.KwikFuzzTest",
      "method": "fuzzServerConnectionRegistryRegisterConnection"
    }
  }
}
