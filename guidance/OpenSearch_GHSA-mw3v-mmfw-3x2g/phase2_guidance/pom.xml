<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.opensearch.fuzz</groupId>
    <artifactId>opensearch-queryparser-fuzz</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>OpenSearch query parser fuzz harness</name>
    <description>
        JQF fuzz harness for OpenSearch query_string parsing and the Lucene query parser and
        regular expression classes it uses.
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
            OpenSearch 3.x (and the benchmark's 3.3.0-SNAPSHOT source tree) needs Java 21 (Lucene 10).
            The build environment is Java 17, so the harness uses OpenSearch 2.19.3, a release of the
            2.x line. The OpenSearch modules are built from the source of tag 2.19.3 with the project's
            Gradle build (version 2.19.3-SNAPSHOT) and are in lib/.
            lucene.version matches the Lucene release that OpenSearch 2.19.3 depends on.
        -->
        <opensearch.version>2.19.3-SNAPSHOT</opensearch.version>
        <lucene.version>9.12.2</lucene.version>

        <!-- JQF and quickcheck versions -->
        <jqf.version>2.1</jqf.version>
        <junit.version>4.13.2</junit.version>
    </properties>

    <dependencies>
        <!--
            =====================================================================
            OPENSEARCH MODULES (system scope, lib/)
            The server module and the OpenSearch libraries it depends on, built
            from source.
            =====================================================================
        -->
        <dependency>
            <groupId>org.opensearch</groupId>
            <artifactId>opensearch</artifactId>
            <version>${opensearch.version}</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/opensearch-${opensearch.version}.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.opensearch</groupId>
            <artifactId>opensearch-cli</artifactId>
            <version>${opensearch.version}</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/opensearch-cli-${opensearch.version}.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.opensearch</groupId>
            <artifactId>opensearch-common</artifactId>
            <version>${opensearch.version}</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/opensearch-common-${opensearch.version}.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.opensearch</groupId>
            <artifactId>opensearch-compress</artifactId>
            <version>${opensearch.version}</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/opensearch-compress-${opensearch.version}.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.opensearch</groupId>
            <artifactId>opensearch-core</artifactId>
            <version>${opensearch.version}</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/opensearch-core-${opensearch.version}.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.opensearch</groupId>
            <artifactId>opensearch-geo</artifactId>
            <version>${opensearch.version}</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/opensearch-geo-${opensearch.version}.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.opensearch</groupId>
            <artifactId>opensearch-secure-sm</artifactId>
            <version>${opensearch.version}</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/opensearch-secure-sm-${opensearch.version}.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.opensearch</groupId>
            <artifactId>opensearch-task-commons</artifactId>
            <version>${opensearch.version}</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/opensearch-task-commons-${opensearch.version}.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.opensearch</groupId>
            <artifactId>opensearch-telemetry</artifactId>
            <version>${opensearch.version}</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/opensearch-telemetry-${opensearch.version}.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.opensearch</groupId>
            <artifactId>opensearch-x-content</artifactId>
            <version>${opensearch.version}</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/opensearch-x-content-${opensearch.version}.jar</systemPath>
        </dependency>

        <!--
            =====================================================================
            THIRD-PARTY RUNTIME DEPENDENCIES OF THE OPENSEARCH MODULES
            Declared as in the POMs that the OpenSearch 2.19.3 build generates
            for these modules (same versions, every one without its own
            transitive dependencies).
            =====================================================================
        -->
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-backward-codecs</artifactId>
            <version>${lucene.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-grouping</artifactId>
            <version>${lucene.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
