{
  "build": [
    "mvn package -DskipTests -q 2>&1 | tail -30",
    "mkdir -p target/agents",
    "printf 'Premain-Class: dosguide.agent.DoSMeasureAgent\\nCan-Retransform-Classes: true\\n\\n' > target/agents/MANIFEST.MF",
    "jar cfm target/agents/dos-measure-agent.jar target/agents/MANIFEST.MF -C target/test-classes dosguide/agent"
  ],
  "classpath": "target/test-classes:target/classes:lib/token-macro-2.6-SNAPSHOT.jar:target/deps/*",
  "javaagent": {
    "jar": "target/agents/dos-measure-agent.jar",
    "args": ""
  },
  "jvm_args": [],
  "guidance_factory": "dosguide.FuzzRunner#createGuidance",
  "targets": {
    "V1": {
      "test_class": "edu.berkeley.cs.jqf.examples.tokenmacro.TokenMacroFuzzTest",
      "method": "fuzzTokenMacroExpand"
    },
    "V2": {
      "test_class": "edu.berkeley.cs.jqf.examples.tokenmacro.TokenMacroFuzzTest",
      "method": "fuzzBeginningOrEndMatchTransormTransform"
    }
  }
}
