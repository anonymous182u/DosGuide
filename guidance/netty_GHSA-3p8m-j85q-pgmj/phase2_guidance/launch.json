{
  "build": [
    "mvn -q compile test-compile 2>&1 | tail -30",
    "mvn -q dependency:copy-dependencies -DincludeScope=test -DoutputDirectory=target/deps 2>&1 | tail -20",
    "mkdir -p target/agent-meta && printf 'Premain-Class: fuzzing.agent.DecompressAgent\\nCan-Retransform-Classes: true\\n' > target/agent-meta/MANIFEST.MF && jar cfm target/decompression-agent.jar target/agent-meta/MANIFEST.MF -C target/test-classes fuzzing/agent/"
  ],
  "classpath": "target/test-classes:target/classes:lib/netty-common-4.2.5.Final-SNAPSHOT.jar:lib/netty-buffer-4.2.5.Final-SNAPSHOT.jar:lib/netty-resolver-4.2.5.Final-SNAPSHOT.jar:lib/netty-transport-4.2.5.Final-SNAPSHOT.jar:lib/netty-codec-base-4.2.5.Final-SNAPSHOT.jar:lib/netty-codec-compression-4.2.5.Final-SNAPSHOT.jar:target/deps/*",
  "javaagent": {
    "jar": "target/decompression-agent.jar",
    "args": ""
  },
  "jvm_args": [],
  "guidance_factory": "fuzzing.runner.FuzzRunner#createGuidance",
  "targets": {
    "V1": {
      "test_class": "fuzzing.harness.DecompressionFuzzTest",
      "method": "fuzzBrotliDecoderDecode"
    },
    "V2": {
      "test_class": "fuzzing.harness.DecompressionFuzzTest",
      "method": "fuzzZstdDecoderDecode"
    }
  }
}
