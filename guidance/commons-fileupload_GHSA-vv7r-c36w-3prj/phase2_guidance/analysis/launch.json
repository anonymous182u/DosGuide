{
  "build": [
    "mvn -q package -DskipTests",
    "rm -rf target/agent-build && mkdir -p target/agent-build",
    "cd target/agent-build && jar xf ../dependency/asm-9.8.jar org/",
    "cd target/agent-build && jar xf ../dependency/asm-commons-9.5.jar org/",
    "mkdir -p target/agent-build/com/fuzzing/agent",
    "cp target/test-classes/com/fuzzing/agent/V1Counters.class target/agent-build/com/fuzzing/agent/",
    "cp target/test-classes/com/fuzzing/agent/V1MeasureAgent.class target/agent-build/com/fuzzing/agent/",
    "cp target/test-classes/com/fuzzing/agent/V1MeasureAgent$*.class target/agent-build/com/fuzzing/agent/",
    "printf 'Premain-Class: com.fuzzing.agent.V1MeasureAgent\\nCan-Retransform-Classes: true\\n' > target/agent-build/manifest.txt",
    "jar cfm target/v1-agent.jar target/agent-build/manifest.txt -C target/agent-build com/ -C target/agent-build org/"
  ],
  "classpath": "target/test-classes:lib/commons-fileupload-1.6.0-SNAPSHOT.jar:target/dependency/antlr-runtime-3.1.2.jar:target/dependency/asm-9.8.jar:target/dependency/asm-commons-9.5.jar:target/dependency/asm-tree-9.5.jar:target/dependency/commons-fileupload-1.6.0-SNAPSHOT.jar:target/dependency/commons-io-2.19.0.jar:target/dependency/eclipse-collections-10.4.0.jar:target/dependency/eclipse-collections-api-10.4.0.jar:target/dependency/generics-resolver-3.0.1.jar:target/dependency/hamcrest-core-1.3.jar:target/dependency/jackson-annotations-2.18.3.jar:target/dependency/jackson-core-2.18.3.jar:target/dependency/jackson-databind-2.18.3.jar:target/dependency/javaruntype-1.3.jar:target/dependency/javassist-3.20.0-GA.jar:target/dependency/jqf-fuzz-2.1.jar:target/dependency/jqf-instrument-2.1.jar:target/dependency/junit-4.13.2.jar:target/dependency/junit-quickcheck-core-1.0.jar:target/dependency/junit-quickcheck-generators-1.0.jar:target/dependency/ognl-3.1.12.jar:target/dependency/org.jacoco.core-0.8.10.jar:target/dependency/org.jacoco.report-0.8.10.jar:target/dependency/picocli-4.0.4.jar:target/dependency/servlet-api-2.5.jar:target/dependency/slf4j-api-1.7.25.jar",
  "javaagent": {"jar": "target/v1-agent.jar", "args": ""},
  "jvm_args": [
    "-Xmx1g",
    "-Xss1m",
    "-Djqf.ei.MAX_INPUT_SIZE=10240"
  ],
  "guidance_factory": "com.fuzzing.runner.FuzzRunner#createGuidance",
  "targets": {
    "V1": {
      "test_class": "com.fuzzing.harness.MultipartFuzzTest",
      "method": "fuzzMultipartStreamReadHeaders"
    }
  }
}
