{
  "build": [
    "mvn package -DskipTests -q",
    "mkdir -p target/agent-meta/META-INF",
    "printf 'Premain-Class: org.xnio.fuzz.agent.RecursionDepthAgent\\nCan-Retransform-Classes: true\\n' > target/agent-meta/META-INF/MANIFEST.MF",
    "jar cfm target/recursion-agent.jar target/agent-meta/META-INF/MANIFEST.MF -C target/test-classes org/xnio/fuzz/agent"
  ],
  "classpath": "target/test-classes:target/dependency/*:lib/*",
  "javaagent": {
    "jar": "target/recursion-agent.jar",
    "args": ""
  },
  "jvm_args": [
    "-Xmx1g",
    "-Xss1m",
    "-Djqf.ei.MAX_INPUT_SIZE=65536"
  ],
  "guidance_factory": "org.xnio.fuzz.FuzzRunner#createGuidance",
  "targets": {
    "V1": {
      "test_class": "org.xnio.fuzz.XnioFuzzTest",
      "method": "fuzzIoFutureAddNotifier"
    },
    "V2": {
      "test_class": "org.xnio.fuzz.XnioFuzzTest",
      "method": "fuzzFutureResultAddCancelHandler"
    }
  }
}
