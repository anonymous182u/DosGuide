{
  "build": [
    "mvn package -DskipTests -q",
    "mkdir -p target/agent-meta",
    "printf 'Premain-Class: com.fuzzing.agent.V1MeasureAgent\nCan-Retransform-Classes: true\n' > target/agent-meta/MANIFEST.MF",
    "jar cfm target/v1-agent.jar target/agent-meta/MANIFEST.MF -C target/test-classes com/fuzzing/agent/"
  ],
  "classpath": "target/test-classes:lib/cxf-core-4.1.1-SNAPSHOT.jar:target/dependency/jakarta.annotation-api-2.1.1.jar:target/dependency/jaxb-runtime-4.0.5.jar:target/dependency/jaxb-core-4.0.5.jar:target/dependency/txw2-4.0.5.jar:target/dependency/istack-commons-runtime-4.1.2.jar:target/dependency/woodstox-core-7.1.0.jar:target/dependency/stax2-api-4.2.2.jar:target/dependency/xmlschema-core-2.3.1.jar:target/dependency/angus-activation-2.0.2.jar:target/dependency/jakarta.activation-api-2.1.3.jar:target/dependency/jakarta.xml.bind-api-4.0.2.jar:target/dependency/jqf-fuzz-2.1.jar:target/dependency/jqf-instrument-2.1.jar:target/dependency/junit-quickcheck-core-1.0.jar:target/dependency/junit-quickcheck-generators-1.0.jar:target/dependency/junit-4.13.2.jar:target/dependency/asm-9.8.jar:target/dependency/asm-commons-9.5.jar:target/dependency/asm-tree-9.5.jar:target/dependency/hamcrest-core-1.3.jar:target/dependency/org.jacoco.core-0.8.10.jar:target/dependency/org.jacoco.report-0.8.10.jar:target/dependency/picocli-4.0.4.jar:target/dependency/eclipse-collections-10.4.0.jar:target/dependency/eclipse-collections-api-10.4.0.jar:target/dependency/jackson-databind-2.18.3.jar:target/dependency/jackson-annotations-2.18.3.jar:target/dependency/jackson-core-2.18.3.jar:target/dependency/javaruntype-1.3.jar:target/dependency/antlr-runtime-3.1.2.jar:target/dependency/ognl-3.1.12.jar:target/dependency/javassist-3.20.0-GA.jar:target/dependency/generics-resolver-3.0.1.jar:target/dependency/slf4j-api-1.7.25.jar",
  "javaagent": {"jar": "target/v1-agent.jar", "args": ""},
  "jvm_args": [],
  "guidance_factory": "com.fuzzing.runner.FuzzRunner#createGuidance",
  "targets": {
    "V1": {
      "test_class": "org.apache.cxf.io.fuzz.CachedOutputStreamFuzzTest",
      "method": "fuzzCachedOutputStreamCleanerForceClean"
    }
  }
}
