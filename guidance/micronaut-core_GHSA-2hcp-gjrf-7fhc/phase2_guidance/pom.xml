<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.fuzzing</groupId>
    <artifactId>micronaut-fuzz</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- micronaut-core modules http-server, http, router, context-propagation, context, aop, inject,
             core-reactive and core, built from the micronaut-core source (version 4.10.17-SNAPSHOT, lib/) -->
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-http-server</artifactId>
            <version>4.10.17-SNAPSHOT</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/micronaut-http-server-4.10.17-SNAPSHOT.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-http</artifactId>
            <version>4.10.17-SNAPSHOT</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/micronaut-http-4.10.17-SNAPSHOT.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-router</artifactId>
            <version>4.10.17-SNAPSHOT</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/micronaut-router-4.10.17-SNAPSHOT.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-context-propagation</artifactId>
            <version>4.10.17-SNAPSHOT</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/micronaut-context-propagation-4.10.17-SNAPSHOT.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-context</artifactId>
            <version>4.10.17-SNAPSHOT</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/micronaut-context-4.10.17-SNAPSHOT.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-aop</artifactId>
            <version>4.10.17-SNAPSHOT</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/micronaut-aop-4.10.17-SNAPSHOT.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-inject</artifactId>
            <version>4.10.17-SNAPSHOT</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/micronaut-inject-4.10.17-SNAPSHOT.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-core-reactive</artifactId>
            <version>4.10.17-SNAPSHOT</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/micronaut-core-reactive-4.10.17-SNAPSHOT.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-core</artifactId>
            <version>4.10.17-SNAPSHOT</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/micronaut-core-4.10.17-SNAPSHOT.jar</systemPath>
        </dependency>

        <!-- ===== THIRD-PARTY RUNTIME DEPS of these modules (versions of the micronaut-core build) ===== -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>2.1.1</version>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <version>2.0.1</version>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
            <version>3.7.12</version>
        </dependency>
        <dependency>
            <groupId>org.reactivestreams</groupId>
            <artifactId>reactive-streams</artifactId>
            <version>1.0.4</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.17</version>
        </dependency>

        <!-- ===== JQF FUZZING ===== -->
        <dependency>
            <groupId>edu.berkeley.cs.jqf</groupId>
            <artifactId>jqf-fuzz</artifactId>
            <version>2.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>edu.berkeley.cs.jqf</groupId>
            <artifactId>jqf-instrument</artifactId>
            <version>2.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.pholser</groupId>
            <artifactId>junit-quickcheck-core</artifactId>
            <version>1.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.pholser</groupId>
            <artifactId>junit-quickcheck-generators</artifactId>
            <version>1.0</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 4 (required by JQF) -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <compilerArgs>
                        <arg>-proc:none</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- Copy all dependencies for classpath assembly -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>copy-deps</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/deps</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
