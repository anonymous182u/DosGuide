{
  "build": [
    "mvn package -DskipTests -q 2>&1 | tail -30",
    "bash build-agent.sh"
  ],
  "classpath_command": "echo target/test-classes:target/classes:lib/snakeyaml-1.31-SNAPSHOT.jar:$(find target/deps -name '*.jar' | tr '\\n' ':')",
  "javaagent": {"jar": "target/v1-agent.jar", "args": ""},
  "jvm_args": [],
  "guidance_factory": "v1.FuzzRunner#createGuidance",
  "targets": {
    "V1": {
      "test_class": "com.fuzz.snakeyaml.SnakeYamlFuzzTest",
      "method": "fuzzYamlLoad"
    }
  }
}
