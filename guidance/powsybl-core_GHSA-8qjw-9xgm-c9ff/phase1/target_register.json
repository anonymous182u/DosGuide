      "entrypoint": "RegexCriterionFuzzTest.fuzzRegexCriterionFilter(InputStream) → RegexCriterion(String) → RegexCriterion.filter(Identifiable, IdentifiableType) → Pattern.compile(String) → Matcher.find()",
