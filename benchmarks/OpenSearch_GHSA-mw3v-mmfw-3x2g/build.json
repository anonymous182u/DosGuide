  "commands": [
    "cat > no-spotless-steps.init.gradle <<'EOF'\n// gradle/formatting.gradle configures Spotless (a source formatting check; it does not take part in compilation)\n// with the Eclipse P2 mirror https://mirror.umd.edu/eclipse/, which no longer serves eclipse/updates/4.29, and the\n// build realizes every task at configuration time, so the Spotless tasks cannot be created (\"Failed to load eclipse\n// jdt formatter\"). This init script appends, to every Spotless format, a last configuration action that removes its\n// formatter steps (FormatExtension.clearSteps()), so no formatter is downloaded. No Spotless task is run in this\n// build; the sources and build files of the project are unchanged.\nallprojects { p ->\n  p.afterEvaluate {\n    def ext = p.extensions.findByName(\"spotless\")\n    if (ext != null) {\n      ext.@formats.values().each { f -> f.@lazyActions.add({ fe -> fe.clearSteps() } as org.gradle.api.Action) }\n    }\n  }\n}\nEOF",
    "cd src && ./gradlew --no-daemon --init-script ../no-spotless-steps.init.gradle \"-Dorg.gradle.jvmargs=-Xmx6g -XX:+HeapDumpOnOutOfMemoryError -Xss2m --add-exports jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED --add-exports jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED --add-exports jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED --add-exports jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED --add-exports jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED\" --max-workers=4 :server:jar :libs:opensearch-cli:jar :libs:opensearch-common:jar :libs:opensearch-compress:jar :libs:opensearch-core:jar :libs:opensearch-geo:jar :libs:opensearch-secure-sm:jar :libs:opensearch-task-commons:jar :libs:opensearch-telemetry:jar :libs:opensearch-x-content:jar -x test"
  ],
